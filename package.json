{
  "name": "@hackerfish/dsh-video-studio",
  "version": "0.2.0",
  "description": "鲸影 DSH Video Studio：DSH 原生视频/漫剧生成插件（七段导演流水线 × 多账号额度池 × 提示词自优化 × 自我审计）",
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/wrap-client.mjs && node scripts/self-test-client.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "self-audit": "node scripts/self-audit.ts"
  },
  "license": "MIT",
  "main": "./lib/host/index.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/host/index.mjs"
    },
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3"
  }
}
