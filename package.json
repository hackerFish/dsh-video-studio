{
  "name": "@hackerfish/dsh-video-studio",
  "version": "0.1.0",
  "description": "鲸影 DSH Video Studio：DSH 原生视频/漫剧生成插件（六段导演流水线 × 多供应商额度调度 × 提示词自优化）",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "main": "./src/host/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "src/host",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  }
}